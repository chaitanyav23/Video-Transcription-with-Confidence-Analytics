# Environment Configuration for CS698B Video Transcription Platform
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501
API_URL=http://127.0.0.1:8000

# Storage
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=250
MAX_DURATION_SECONDS=1800

# ML Inference
MOCK_INFERENCE=true
DEVICE=cpu
COMPUTE_TYPE=int8
HF_TOKEN=your_huggingface_token_here
