# Environment Configuration for CS698B Video Transcription Platform
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501
API_URL=http://127.0.0.1:8000

# Storage
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=250
MAX_DURATION_SECONDS=1800

# ML Inference Configuration (Real Phase 20 pipeline)
DEVICE=cuda
COMPUTE_TYPE=float16

# Hugging Face Authentication (Optional for NeMo/Faster-Whisper/Wav2Vec2; required for Pyannote gated models)
# Token resolution priority:
# 1. HF_TOKEN (set in environment or privately in app/.env)
# 2. HUGGINGFACE_HUB_TOKEN (in environment)
# 3. Local cached token from 'huggingface-cli login' (~/.cache/huggingface/token)
# 4. None (if unset)
#
# Set your actual token privately in app/.env (never commit credentials).
# Example placeholder only (do not uncomment in template):
# HF_TOKEN=your_huggingface_token_here
